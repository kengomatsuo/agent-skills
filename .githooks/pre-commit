#!/usr/bin/env bash
# Refuse a commit whose skills break Anthropic's authoring rules
# (scripts/skill-lint.ts in agent-skills), then one with private terms.
lint="scripts/skill-lint.ts"
if command -v bun >/dev/null && [ -f "$lint" ]; then
  bun "$lint" skills >&2 || { echo "pre-commit: skill-lint failed" >&2; exit 1; }
fi
# check-notes.ts is copied into three skills (each must stand alone); copies must match
if ! cmp -s skills/design-research/check-notes.ts skills/backend-research/check-notes.ts ||
   ! cmp -s skills/design-research/check-notes.ts skills/code-to-copy/check-notes.ts; then
  echo "pre-commit: the three check-notes.ts copies differ; edit all three" >&2; exit 1
fi

terms="${PRIVATE_TERMS:-$HOME/.claude/private-terms.txt}"
[ -f "$terms" ] || exit 0
pattern=$(grep -v -e '^#' -e '^$' "$terms" | paste -sd'|' -)
[ -n "$pattern" ] || exit 0
hits=$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -v -E '^\+\+\+' | grep -i -n -E "(^|[^[:alnum:]])($pattern)([^[:alnum:]]|$)")
if [ -n "$hits" ]; then
  echo "pre-commit: private terms in staged lines:" >&2
  echo "$hits" | cut -c1-160 >&2
  exit 1
fi
